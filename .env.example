# Copy to .env, then: docker compose up --build
# Never commit .env. Values below are for local development only.

# --- Postgres (docker compose) ---
POSTGRES_DB=dadrose
POSTGRES_USER=dadrose
POSTGRES_PASSWORD=dadrose

# --- Backend ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

# Object storage (ArvanCloud S3). With USE_S3=false files go to media/ and private_media/.
USE_S3=false
S3_ENDPOINT_URL=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMS: "console" logs messages instead of sending them.
SMS_PROVIDER=console
# DATABASE_URL, REDIS_URL and DJANGO_SETTINGS_MODULE are set by docker-compose.yml.

# --- Frontend ---
# Server-side API base (inside docker the backend service is reachable as "backend")
API_INTERNAL_URL=http://backend:8000/api/v1
# Browser-side API base
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public site origin (canonical URLs, Open Graph, metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: public S3 host for covers in production (e.g. dadrose.s3.ir-thr-at1.arvanstorage.ir)
NEXT_PUBLIC_MEDIA_HOST=
# Local dev/tests only: 1 = serve data from src/lib/__fixtures__ instead of calling the API
USE_API_FIXTURES=0
