# Copy to .env, then: docker compose up --build
# Never commit .env. Values below are for local development only.

# --- Postgres (docker compose) ---
POSTGRES_DB=dadrose
POSTGRES_USER=dadrose
POSTGRES_PASSWORD=dadrose

# --- Backend ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000
# Study-plan lead form: POSTs allowed per client IP. Behind a reverse proxy set NUM_PROXIES (e.g. 1)
# so the client IP is read from X-Forwarded-For.
STUDY_PLAN_THROTTLE_RATE=10/hour
# NUM_PROXIES=1

# Admin security. STAFF_2FA_REQUIRED: after the password, staff confirm a 6-digit SMS code
# (console SMS while developing: the code is in `docker compose logs backend`).
# ADMIN_ALLOWED_IPS: comma-separated IPs or CIDR networks that may open /admin/ (others get 404);
# empty = everyone. Behind a reverse proxy set NUM_PROXIES too, or every request has the proxy's IP.
STAFF_2FA_REQUIRED=true
ADMIN_ALLOWED_IPS=
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Object storage (ArvanCloud S3). With USE_S3=false files go to media/ and private_media/.
USE_S3=false
S3_ENDPOINT_URL=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=
# Ebook reader: lifetime of signed ebook URLs (seconds). Private bucket needs CORS GET from the site.
READER_URL_TTL_SECONDS=300
# Ebook platform (Phase 6): devices per user, characters per copy, anti-scraping rates per user.
READER_MAX_DEVICES=3
READER_COPY_LIMIT=1000
READER_CHAPTER_RATE=30/min
READER_CHAPTER_DAY_RATE=800/day
READER_SEARCH_RATE=30/min
# Total copy quota per user and book (percent of an EPUB; fixed characters for PDF).
READER_COPY_QUOTA_PERCENT=10
READER_PDF_COPY_QUOTA=20000
# Offline reading of EPUBs (whole book kept encrypted on one device for N days).
READER_OFFLINE_ENABLED=true
READER_OFFLINE_MAX_BOOKS=3
READER_OFFLINE_DAYS=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMS: "console" logs messages instead of sending them.
SMS_PROVIDER=console

# --- Phase 3: login, payments ---
# Login codes are also printed in `docker compose logs backend` while DEBUG=true (console SMS).
# JWT_SIGNING_KEY=  (defaults to SECRET_KEY)
# Payments: "zarinpal" (sandbox while ZARINPAL_SANDBOX=true) or "fake" (local simulator, no internet).
PAYMENT_GATEWAY=zarinpal
ZARINPAL_SANDBOX=true
# Sandbox accepts any 36-character merchant id; put the real one here only in production.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# Browser-reachable URLs: the bank returns to the API callback, which redirects to the storefront.
PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000
ORDER_PAYMENT_TIMEOUT_MINUTES=60
# SEO beacons (redirect hits and 404 reports from the frontend): POSTs allowed per client IP.
SEO_BEACON_THROTTLE_RATE=120/min

# Server-side analytics (self-hosted Umami). Empty UMAMI_HOST or UMAMI_WEBSITE_ID → events are
# not sent. UMAMI_HOST is the Umami origin (e.g. https://stats.dadrosebook.com), UMAMI_WEBSITE_ID
# the website UUID from the Umami dashboard, SITE_HOST the store hostname (e.g. dadrosebook.com).
UMAMI_HOST=
UMAMI_WEBSITE_ID=
SITE_HOST=

# DATABASE_URL, REDIS_URL and DJANGO_SETTINGS_MODULE are set by docker-compose.yml.

# --- Frontend ---
# Server-side API base (inside docker the backend service is reachable as "backend")
API_INTERNAL_URL=http://backend:8000/api/v1
# Browser-side API base
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public site origin (canonical URLs, Open Graph, metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: public S3 host for covers in production (e.g. dadrose.s3.ir-thr-at1.arvanstorage.ir)
NEXT_PUBLIC_MEDIA_HOST=
# Public environment: "production" lets search engines crawl (robots.txt) — anything else
# (development, staging) serves "Disallow: /". Inlined at build time (Docker build arg).
NEXT_PUBLIC_SITE_ENV=development
# Self-hosted Umami analytics (docs/analytics.md). Both empty → no script is loaded; track() still
# dispatches the "dadrose:analytics" DOM event. SRC is the script URL
# (e.g. https://stats.dadrosebook.com/script.js), WEBSITE_ID the site's id in Umami. Build-time values.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Local dev/tests only: 1 = serve data from src/lib/__fixtures__ instead of calling the API
USE_API_FIXTURES=0

# Phase 2: storefront URL used in back-in-stock SMS links; cart limits; notify-me throttle.
SITE_URL=http://localhost:3000
CART_MAX_QUANTITY=10
CART_TTL_DAYS=60
BACK_IN_STOCK_THROTTLE_RATE=10/hour

# Growth (apps.growth): Torob product API v3 at POST /torob_api/v3/products (storefront rewrite).
# Confirm field names, price unit and JWT claims in the Torob seller panel. Empty key → 403 in production.
TOROB_PUBLIC_KEY=
TOROB_JWT_AUDIENCE=
TOROB_PRICE_UNIT=toman
NEXT_PUBLIC_TOROB_PRICE_UNIT=toman
# Days a gift recipient has to claim the link.
GIFT_CLAIM_DAYS=90
