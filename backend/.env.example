# Backend environment (copy to backend/.env for local runs; docker compose uses the root .env).
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://dadrose:dadrose@localhost:5432/dadrose
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

# Object storage (ArvanCloud S3). With USE_S3=false files go to media/ and private_media/.
USE_S3=false
S3_ENDPOINT_URL=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=
# Ebook reader: lifetime of signed ebook URLs (seconds). Private bucket needs CORS GET from the site.
READER_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMS: "console" logs messages instead of sending them.
SMS_PROVIDER=console
