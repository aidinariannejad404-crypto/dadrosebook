# Production environment for docker-compose.prod.yml.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   # then replace every CHANGE_ME
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod is gitignored. Never commit it. See docs/deploy.md.
#
# Generate secrets with:   openssl rand -hex 32
# Postgres/Redis passwords end up inside URLs: use hex (letters+digits only), no @ : / # ? %.

# --- Domains / TLS (Caddy) ------------------------------------------------------------------------
# The store (apex). www.<SITE_DOMAIN> is redirected (301) to it.
SITE_DOMAIN=dadrosebook.com
# Umami analytics dashboard + tracker script.
STATS_DOMAIN=stats.dadrosebook.com
# Let's Encrypt account / expiry notices.
ACME_EMAIL=CHANGE_ME@example.com
# Only when a CDN (e.g. ArvanCloud) sits in front of Caddy: its edge IP ranges, space separated.
# Then also set NUM_PROXIES=2. Default (no CDN): 127.0.0.1/32 and NUM_PROXIES=1.
TRUSTED_PROXIES=127.0.0.1/32

# --- Postgres ----------------------------------------------------------------------------------------
POSTGRES_DB=dadrose
POSTGRES_USER=dadrose
POSTGRES_PASSWORD=CHANGE_ME_hex
# Umami's own database "umami" (role "umami") on the same server, created by
# deploy/postgres/init-umami.sh on first start.
UMAMI_DB_PASSWORD=CHANGE_ME_hex

# --- Redis (cache + Celery broker; internal only, password protected) -------------------------------
REDIS_PASSWORD=CHANGE_ME_hex

# --- Django ------------------------------------------------------------------------------------------
# 50+ random characters. The app refuses to start with a default/weak value.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
# "backend" and "localhost" are needed for the frontend's internal calls and the healthcheck.
ALLOWED_HOSTS=dadrosebook.com,www.dadrosebook.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://dadrosebook.com,https://www.dadrosebook.com
CORS_ALLOWED_ORIGINS=https://dadrosebook.com
# Number of reverse proxies in front of Django: 1 = Caddy only, 2 = CDN + Caddy.
NUM_PROXIES=1
# Caddy redirects http→https; Django's own redirect stays off (internal http calls). See prod.py.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
# true only if EVERY subdomain of SITE_DOMAIN is HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
STUDY_PLAN_THROTTLE_RATE=10/hour
HOME_CACHE_SECONDS=60
# Logging: json (default) or text; level INFO/WARNING/…
LOG_FORMAT=json
LOG_LEVEL=INFO
# gunicorn extra flags (the Dockerfile already sets --workers 3).
GUNICORN_CMD_ARGS=--timeout 60 --graceful-timeout 30 --max-requests 2000 --max-requests-jitter 200 --control-socket /tmp/gunicorn.ctl

# Optional error e-mails: comma-separated admin addresses + an SMTP URL
# (e.g. smtp+tls://user:password@smtp.example.com:587). Leave empty to only log errors.
ADMINS=
EMAIL_URL=
SERVER_EMAIL=noreply@dadrosebook.com
DEFAULT_FROM_EMAIL=noreply@dadrosebook.com

# --- Object storage (ArvanCloud S3-compatible) ----------------------------------------------------
# false = files on the server's docker volumes (media served by Caddy at /media/).
# true  = public bucket for covers/samples, PRIVATE bucket for ebook files (must never be public).
USE_S3=false
S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
S3_PUBLIC_BUCKET=dadrose-public
S3_PRIVATE_BUCKET=dadrose-private
S3_REGION=ir-thr-at1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Integrations ------------------------------------------------------------------------------------
# SMS: "console" only logs messages. Real provider (e.g. kavenegar) = owner decision + API key.
SMS_PROVIDER=console
# SMS_API_KEY=
# Payment (Phase 3, ZarinPal) — owner decision; placeholders, not read by the app yet.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Server-side analytics events (purchase) → Umami. Internal address is fine.
UMAMI_HOST=http://umami:3000
# Website id from the Umami dashboard (same value as NEXT_PUBLIC_UMAMI_WEBSITE_ID).
UMAMI_WEBSITE_ID=
# Hostname reported with server-side events.
SITE_HOST=dadrosebook.com

# --- Umami -------------------------------------------------------------------------------------------
UMAMI_APP_SECRET=CHANGE_ME_hex
# Pin a version after the first deploy, e.g. ghcr.io/umami-software/umami:<version>
UMAMI_IMAGE=ghcr.io/umami-software/umami:latest

# --- Frontend (NEXT_PUBLIC_* are baked in at BUILD time → rebuild the frontend after changes) ------
NEXT_PUBLIC_API_URL=https://dadrosebook.com/api/v1
NEXT_PUBLIC_SITE_URL=https://dadrosebook.com
# Host that serves cover images: the public bucket host when USE_S3=true
# (e.g. dadrose-public.s3.ir-thr-at1.arvanstorage.ir), otherwise the site domain itself.
NEXT_PUBLIC_MEDIA_HOST=dadrosebook.com
# "production" enables indexing in robots.txt. Anything else → Disallow: /
NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_UMAMI_SRC=https://stats.dadrosebook.com/script.js
# Fill in after creating the website in Umami, then rebuild the frontend.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Backups (deploy/backup.sh) ------------------------------------------------------------------
BACKUP_DIR=/var/backups/dadrosebook
BACKUP_KEEP_DAYS=14
# Optional off-site copy. Either an S3 bucket via the aws cli…
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
# …or an rclone remote path, e.g. arvan:dadrose-backups
BACKUP_RCLONE_REMOTE=
